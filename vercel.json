{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
    "services": {
    "app": {
      "root": ".",
      "framework": "express"
    },
    "server-node": {
      "root": "server-node",
      "framework": "express"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.mjs"
    },
    {
      "source": "/auth/(.*)",
      "destination": "/api/index.mjs"
    }
  ]
}

