{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run start:prod",
  "outputDirectory": "dist",
  "functions": {
    "api/index.mjs": {
      "runtime": "nodejs22.x"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.mjs"
    },
    {
      "source": "/auth/(.*)",
      "destination": "/api/index.mjs"
    }
  ]
}
